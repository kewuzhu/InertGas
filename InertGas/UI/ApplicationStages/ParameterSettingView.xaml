<UserControl
    x:Class="InertGas.Application.UI.ApplicationStages.ParameterSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:appStages="clr-namespace:InertGas.Application.UI.ApplicationStages"
    d:DataContext="{d:DesignInstance Type=appStages:ParameterSettingViewModel}"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Black">
    <Grid
        Width="350"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Text="Gas flow">
        </TextBlock>
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Text="Charcoal Column Temperature">
        </TextBlock>
        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Text="4A temperature">
        </TextBlock>
        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Text="5A temperature">
        </TextBlock>
        <TextBox
            Grid.Row="0"
            Grid.Column="2">
        </TextBox>
        <TextBox
            Grid.Row="2"
            Grid.Column="2">
        </TextBox>
        <TextBox
            Grid.Row="4"
            Grid.Column="2">
        </TextBox>
        <TextBox
            Grid.Row="6"
            Grid.Column="2">
        </TextBox>
    </Grid>
</UserControl>
