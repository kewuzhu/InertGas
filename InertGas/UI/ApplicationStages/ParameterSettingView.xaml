<UserControl
    x:Class="InertGas.Application.UI.ApplicationStages.ParameterSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:themes="clr-namespace:InertGas.Application.Themes"
    xmlns:commonModel="clr-namespace:InertGas.Common.Model;assembly=InertGas.Common"
    xmlns:appStages="clr-namespace:InertGas.Application.UI.ApplicationStages"
    d:DataContext="{d:DesignInstance Type=appStages:ParameterSettingViewModel}"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Black">
    <Grid
        Width="450"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AppModel.CurrentUser.Role}" Value="{x:Static commonModel:UserRole.Normal}">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <ColumnDefinition />
            <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Center">
            <Run Text="{StaticResource InertGas.Application.CharcoalColumnTemperature}" />
            <Run Text="{StaticResource InertGas.Application.SetTemperatureThreshold}" />
        </TextBlock>
        <TextBox
            Grid.Row="0"
            Grid.Column="2"
            Text="{Binding CharcoalColumnTemperatureThreshold}">
        </TextBox>
        <themes:ImageButton
            Grid.Row="0"
            Grid.Column="4"
            Style="{StaticResource InertGas.ImageButton}"
            Content="{StaticResource InertGas.Common.OK}"
            Command="{Binding SetCharcoalColumnTemperatureThresholdCommand}"
            ImageSource="{StaticResource InertGas.OkayIcon}">
        </themes:ImageButton>
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Center">
            <Run Text="{StaticResource InertGas.Application.Column4A5ATemperature}" />
            <Run Text="{StaticResource InertGas.Application.SetTemperatureThreshold}" />
        </TextBlock>
        <TextBox
            Grid.Row="2"
            Grid.Column="2"
            Text="{Binding Column4A5ATemperatureThreshold}">
        </TextBox>
        <themes:ImageButton
            Grid.Row="2"
            Grid.Column="4"
            Style="{StaticResource InertGas.ImageButton}"
            Content="{StaticResource InertGas.Common.OK}"
            Command="{Binding SetColumn4A5ATemperatureThresholdCommand}"
            ImageSource="{StaticResource InertGas.OkayIcon}">
        </themes:ImageButton>
    </Grid>
</UserControl>
