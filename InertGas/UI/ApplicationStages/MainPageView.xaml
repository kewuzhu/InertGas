<UserControl
    x:Class="InertGas.Application.UI.ApplicationStages.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:appStages="clr-namespace:InertGas.Application.UI.ApplicationStages"
    d:DataContext="{d:DesignInstance Type=appStages:MainPageViewModel}"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ToggleButton
            Grid.Row="0">
        </ToggleButton>
        <ToggleButton
            Grid.Row="1"
            IsChecked="True"
            IsEnabled="False">
        </ToggleButton>
        <ToggleButton
            Grid.Row="2"
            IsEnabled="False">
        </ToggleButton>
    </Grid>
</UserControl>
