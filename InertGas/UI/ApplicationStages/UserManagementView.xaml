<UserControl
    x:Class="InertGas.Application.UI.ApplicationStages.UserManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:themes="clr-namespace:InertGas.Application.Themes"
    xmlns:appStages="clr-namespace:InertGas.Application.UI.ApplicationStages"
    xmlns:converters="clr-namespace:InertGas.Application.Themes.Converters"
    xmlns:commonModel="clr-namespace:InertGas.Common.Model;assembly=InertGas.Common"
    d:DataContext="{d:DesignInstance Type=appStages:UserManagementViewModel}"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="{Binding Path=AppModel.CurrentUser.Role, Converter={converters:UserRoleToStringConverter}}"
            FontSize="{StaticResource InertGas.LargeFontSize}"
            FontWeight="Bold">
        </TextBlock>
        <Grid
            Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                <ColumnDefinition />
                <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                MinWidth="200"
                Text="{Binding UserNameOnSearch}">
            </TextBox>
            <themes:ImageButton
                Grid.Column="2"
                Content="{StaticResource InertGas.Application.Search}"
                ImageSource="{StaticResource InertGas.SearchIcon}"
                Style="{StaticResource InertGas.ImageButton}"
                Command="{Binding SearchUserCommand}">
            </themes:ImageButton>
            <themes:ImageButton
                Grid.Column="6"
                Content="{StaticResource InertGas.Application.Delete}"
                ImageSource="{StaticResource InertGas.DeleteUserIcon}"
                Command="{Binding DeleteUserCommand}">
                <themes:ImageButton.Style>
                    <Style BasedOn="{StaticResource InertGas.ImageButton}" TargetType="themes:ImageButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppModel.CurrentUser.Role}" Value="{x:Static commonModel:UserRole.Normal}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </themes:ImageButton.Style>
            </themes:ImageButton>
            <themes:ImageButton
                Grid.Column="8"
                Content="{StaticResource InertGas.Application.Add}"
                ImageSource="{StaticResource InertGas.AddIcon}"
                Command="{Binding AddUserCommand}">
                <themes:ImageButton.Style>
                    <Style BasedOn="{StaticResource InertGas.ImageButton}" TargetType="themes:ImageButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppModel.CurrentUser.Role}" Value="{x:Static commonModel:UserRole.Normal}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </themes:ImageButton.Style>
            </themes:ImageButton>
        </Grid>
        <ListView
            Grid.Row="4"
            ItemsSource="{Binding AppModel.Users}"
            SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Id}"
                        Header="ID"/>
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Role}"
                        Header="{StaticResource InertGas.Application.Role}"/>
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Name}"
                        Header="{StaticResource InertGas.Application.Name}" />
                    <GridViewColumn
                        DisplayMemberBinding="{Binding Password}"
                        Header="{StaticResource InertGas.Application.Password}" />
                    <GridViewColumn
                        DisplayMemberBinding="{Binding CreatedDate}"
                        Header="{StaticResource InertGas.Application.CreatedDate}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
