<Window x:Class="InertGas.Application.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:behaviors="clr-namespace:InertGas.Application.UI.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:InertGas.Application.UI"
        xmlns:themes="clr-namespace:InertGas.Application.Themes"
        xmlns:model="clr-namespace:InertGas.Application.Model"
        xmlns:appStages="clr-namespace:InertGas.Application.UI.ApplicationStages"
        xmlns:converters="clr-namespace:InertGas.Application.Themes.Converters"
        d:DataContext="{d:DesignInstance Type=ui:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{StaticResource InertGas.Common.Title}"
        Foreground="{StaticResource InertGas.DefaultForegroundColor}"
        Background="{StaticResource InertGas.WindowBackground}"
        Height="550" 
        Width="1040"
        WindowStyle="None">

    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation" Completed="OnAnimationCompleted">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:.45" />
        </Storyboard>
        <Storyboard x:Key="SlideInStoryboard" Completed="OnAnimationCompleted">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="500"
                To="0"
                Duration="0:0:.45" />
        </Storyboard>
        <Storyboard x:Key="SlideOutStoryboard" Completed="OnAnimationCompleted">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="0"
                To="500"
                Duration="0:0:.45" />
        </Storyboard>

        <DataTemplate DataType="{x:Type appStages:MainPageViewModel}">
            <appStages:MainPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appStages:ParameterSettingViewModel}">
            <appStages:ParameterSettingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appStages:DataManagementViewModel}">
            <appStages:DataManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type appStages:UserManagementViewModel}">
            <appStages:UserManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="{StaticResource InertGas.WindowBackground}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                            <Setter Property="Background" Value="{StaticResource InertGas.Background}" />
                            <Setter Property="Opacity" Value="0.3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.Effect>
                <BlurEffect Radius="20" />
            </Grid.Effect>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="9*"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Background="{StaticResource InertGas.WindowBackground}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{StaticResource InertGas.Common.Title}"
                    FontSize="{StaticResource InertGas.LargeFontSize}">
                </TextBlock>
                <ContentControl
                    Grid.Column="4"
                    Height="{StaticResource InertGas.LargeFontSize}"
                    Width="{StaticResource InertGas.LargeFontSize}"
                    Foreground="{StaticResource InertGas.ButtonText}"
                    Template="{StaticResource InertGas.UserIcon}">
                </ContentControl>
                <TextBlock
                    Grid.Column="5"
                    Text="{Binding SelectedUser.Name}"
                    Foreground="{StaticResource InertGas.ButtonText}"
                    FontSize="{StaticResource InertGas.LargeFontSize}">
                </TextBlock>
                <themes:ImageButton
                    Grid.Column="7"
                    Content="{StaticResource InertGas.Common.Close}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Command="{Binding CloseCommand}"
                    ImageSource="{StaticResource InertGas.CloseIcon}"
                    Foreground="{StaticResource InertGas.Red}"
                    Style="{StaticResource InertGas.ImageButton}">
                </themes:ImageButton>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPageSwitchPlaying}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="ShowCountChannelPlot" Storyboard="{StaticResource FadeInAnimation}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="ShowCountChannelPlot" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl
                    Content="{Binding CurrentViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <Grid
                    Width="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.Background>
                            <StaticResource ResourceKey="InertGas.Background" />
                        </Grid.Background>
                    </Grid>
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="{StaticResource InertGas.LargeMarginGridLength}"/>
                                <RowDefinition />
                                <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
                                <RowDefinition />
                                <RowDefinition Height="{StaticResource InertGas.DefaultMarginGridLength}"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                HorizontalAlignment="Center"
                                Text="{StaticResource InertGas.Common.Title}"
                                FontWeight="ExtraBold"
                                FontSize="{StaticResource InertGas.MenuButtonFontSize}">
                            </TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="{StaticResource InertGas.Application.User}"
                                FontWeight="ExtraBold">
                            </TextBlock>
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="3"
                                Text="{Binding UserName}">
                            </TextBox>
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="{StaticResource InertGas.Application.Password}"
                                FontWeight="ExtraBold">
                            </TextBlock>
                            <PasswordBox
                                Grid.Row="4"
                                Grid.Column="3"
                                PasswordChar="*"
                                PasswordChanged="HandlePasswordChanged">
                                <i:Interaction.Behaviors>
                                    <behaviors:PasswordBoxBindingBehavior Password="{Binding SecurePassword}" />
                                </i:Interaction.Behaviors>
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LogInCommand}" />
                                </PasswordBox.InputBindings>
                            </PasswordBox>
                            <Grid
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <themes:ImageButton
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Content="{StaticResource InertGas.Common.Close}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Command="{Binding CloseCommand}"
                                    Style="{StaticResource InertGas.ImageButton}"
                                    ImageSource="{StaticResource InertGas.CloseIcon}"
                                    Foreground="{StaticResource InertGas.Red}">
                                </themes:ImageButton>
                                <themes:ImageButton
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    Content="{StaticResource InertGas.Application.LogIn}"
                                    Command="{Binding LogInCommand}"
                                    Style="{StaticResource InertGas.ImageButton}"
                                    ImageSource="{StaticResource InertGas.LoginIcon}">
                                </themes:ImageButton>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <themes:ImageButton
                    Grid.Column="0"
                    Content="{StaticResource InertGas.Application.MainPage}"
                    ImageSource="{StaticResource InertGas.MainPageIcon}"
                    Command="{Binding SwitchToMainPageCommand}">
                    <themes:ImageButton.Style>
                        <Style BasedOn="{StaticResource InertGas.MenuButton}" TargetType="themes:ImageButton">
                            <Setter Property="IsActive" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppModel.CurrentApplicationStage}" Value="{x:Static model:ApplicationStage.MainPage}">
                                    <Setter Property="IsActive" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </themes:ImageButton.Style>
                </themes:ImageButton>
                <themes:ImageButton
                    Grid.Column="1"
                    Content="{StaticResource InertGas.Application.ParameterSetting}"
                    ImageSource="{StaticResource InertGas.ParameterSettingIcon}"
                    Command="{Binding SwitchToParameterSettingCommand}">
                    <themes:ImageButton.Style>
                        <Style BasedOn="{StaticResource InertGas.MenuButton}" TargetType="themes:ImageButton">
                            <Setter Property="IsActive" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppModel.CurrentApplicationStage}" Value="{x:Static model:ApplicationStage.ParameterSetting}">
                                    <Setter Property="IsActive" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </themes:ImageButton.Style>
                </themes:ImageButton>
                <themes:ImageButton
                    Grid.Column="2"
                    Content="{StaticResource InertGas.Application.DataManagement}"
                    ImageSource="{StaticResource InertGas.DataManagementIcon}"
                    Command="{Binding SwitchToDataManagementCommand}">
                    <themes:ImageButton.Style>
                        <Style BasedOn="{StaticResource InertGas.MenuButton}" TargetType="themes:ImageButton">
                            <Setter Property="IsActive" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppModel.CurrentApplicationStage}" Value="{x:Static model:ApplicationStage.DataManagement}">
                                    <Setter Property="IsActive" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </themes:ImageButton.Style>
                </themes:ImageButton>
                <themes:ImageButton
                    Grid.Column="3"
                    Content="{StaticResource InertGas.Application.UserManagement}"
                    ImageSource="{StaticResource InertGas.UserManagementIcon}"
                    Command="{Binding SwitchToUserManagementCommand}">
                    <themes:ImageButton.Style>
                        <Style BasedOn="{StaticResource InertGas.MenuButton}" TargetType="themes:ImageButton">
                            <Setter Property="IsActive" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppModel.CurrentApplicationStage}" Value="{x:Static model:ApplicationStage.UserManagement}">
                                    <Setter Property="IsActive" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </themes:ImageButton.Style>
                </themes:ImageButton>
            </Grid>
        </Grid>
    </Grid>
</Window>
