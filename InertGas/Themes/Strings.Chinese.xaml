<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="InertGas.SplashScreenLogoHeight">200</system:Double>

    <FontFamily x:Key="InertGas.DefaultFontFamily">Microsoft YaHei</FontFamily>

    <Thickness
        x:Key="InertGas.NavBarMarginThickness"
        Bottom="0"
        Left="125"
        Right="125"
        Top="45" />

    <Thickness
        x:Key="InertGas.StatsDisplayMarginThickness"
        Bottom="50"
        Left="200"
        Right="200"
        Top="50" />

    <system:String x:Key="InertGas.Common.Cancel">取消</system:String>
    <system:String x:Key="InertGas.Common.Close">关闭</system:String>
    <system:String x:Key="InertGas.Common.No">否</system:String>
    <system:String x:Key="InertGas.Common.OK">OK</system:String>
    <system:String x:Key="InertGas.Common.Success">成功</system:String>
    <system:String x:Key="InertGas.Common.Title">惰性气体分离与净化系统</system:String>
    <system:String x:Key="InertGas.Common.Yes">确定</system:String>

    <system:String x:Key="InertGas.Application.DataManagement">数据管理</system:String>
    <system:String x:Key="InertGas.Application.DoubleCheckUserPasswordMessage">请再次检查您所输入的密码是否正确，且与用户名保持一致，然后再次输入。</system:String>
    <system:String x:Key="InertGas.Application.Error">错误</system:String>
    <system:String x:Key="InertGas.Application.IncorrectPassword">密码错误</system:String>
    <system:String x:Key="InertGas.Application.LogIn">登录</system:String>
    <system:String x:Key="InertGas.Application.MainPage">首页</system:String>
    <system:String x:Key="InertGas.Application.Parameter">参数</system:String>
    <system:String x:Key="InertGas.Application.ParameterSetting">参数设置</system:String>
    <system:String x:Key="InertGas.Application.Password">密码</system:String>
    <system:String x:Key="InertGas.Application.User">用户名</system:String>
    <system:String x:Key="InertGas.Application.UserManagement">用户管理</system:String>
    <system:String x:Key="InertGas.Application.WorkingDirectory">工作路径:</system:String>

</ResourceDictionary>
