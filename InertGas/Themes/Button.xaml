<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:InertGas.Application.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Converters.xaml" />
        <ResourceDictionary Source="Constants.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="InertGas.SystemButtonBase" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            SnapsToDevicePixels="true">
                        <ContentPresenter 
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AlertButton" TargetType="ButtonBase" BasedOn="{StaticResource InertGas.SystemButtonBase}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Padding" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value=".7" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value=".4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SystemButton" TargetType="ButtonBase" BasedOn="{StaticResource InertGas.SystemButtonBase}">
        <Setter Property="Width" Value="{DynamicResource InertGas.SystemButtonWidth}" />
        <Setter Property="Height" Value="{DynamicResource InertGas.SystemButtonHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InertGas.SystemButtonBackgroundOnMoseOver}" />
                <Setter Property="Foreground" Value="{DynamicResource InertGas.SystemButtonForegroundOnMoseOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource InertGas.SystemButtonBackgroundIsPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource InertGas.SystemButtonForegroundIsPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonTextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SystemCloseButton" TargetType="ButtonBase" BasedOn="{StaticResource SystemButton}">
        <Setter Property="Width" Value="{DynamicResource InertGas.CloseButtonWidth}" />
        <Setter Property="Background" Value="{DynamicResource InertGas.CloseButtonBackground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InertGas.CloseButtonBackgroundOnMoseOver}" />
                <Setter Property="Foreground" Value="{DynamicResource InertGas.CloseButtonForegroundOnMoseOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource InertGas.CloseButtonBackgroundIsPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource InertGas.CloseButtonForegroundIsPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonTextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SystemButtonLink" TargetType="ButtonBase" BasedOn="{StaticResource InertGas.SystemButtonBase}" >
        <Setter Property="Foreground" Value="{DynamicResource InertGas.LinkButtonText}"/>
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="true">
                        <TextBlock DataContext="{TemplateBinding Content}"
                                   Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InertGas.LinkButtonTextHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InertGas.LinkButtonTextPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource InertGas.LinkButtonTextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InertGas.BaseButtonStyle"
           TargetType="{x:Type ButtonBase}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background"
                Value="{DynamicResource InertGas.ButtonBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource InertGas.ButtonBorder}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Foreground"
                Value="{DynamicResource InertGas.ButtonText}"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Padding"
                Value="16,3,16,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource InertGas.ButtonCornerRadius}"
                            SnapsToDevicePixels="true">
                        <ContentPresenter
                            Name="Presenter" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonTextDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InertGas.ButtonBackgroundHover}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InertGas.ButtonBorderHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonTextHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InertGas.ButtonBackgroundPressed}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InertGas.ButtonBorderPressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.ButtonTextPressed}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InertGas.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="InertGas.MenuButton"
        TargetType="themes:ImageButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:ImageButton">
                    <Border
                        x:Name="border"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{StaticResource InertGas.GradientBackgroundDarkBrush}"
                        BorderBrush="{StaticResource InertGas.GradientBackgroundBrush}"
                        BorderThickness="{StaticResource InertGas.DefaultBorderThickness}">
                        <Grid HorizontalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid 
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Width="{TemplateBinding ActualWidth}"
                                    Height="{TemplateBinding ActualHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="{StaticResource InertGas.DefaultMarginGridLength}"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Name="Icon"
                                        Grid.Column="0"
                                        Margin="{StaticResource InertGas.MediumMarginThickness}"
                                        HorizontalAlignment="Right"
                                        Background="{TemplateBinding Background}"
                                        Foreground="{StaticResource InertGas.GradientMenuButtonForegroundBrush}"
                                        Template="{TemplateBinding ImageSource}" />
                                    <TextBlock
                                        Name="ButtonText"
                                        Grid.Column="2"
                                        FontSize="{StaticResource InertGas.MenuButtonFontSize}"
                                        FontFamily="Segoe UI"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        HorizontalAlignment="Left"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        Foreground="{StaticResource InertGas.GradientMenuButtonForegroundBrush}"
                                        Text="{TemplateBinding Content}">
                                    </TextBlock>
                                </Grid>
                                <Grid 
                                    Grid.Row="1"
                                    Name="ShadowGrid"
                                    Visibility="Collapsed">
                                    <Ellipse
                                        Width="{TemplateBinding ActualWidth}"
                                        Height="{TemplateBinding ActualHeight}"
                                        Stroke="Transparent">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop
                                                    Offset="0"
                                                    Color="{StaticResource InertGas.MainMenuOnClickShadowColorOutter}"/>
                                                <GradientStop 
                                                    Offset="1"
                                                    Color="{StaticResource InertGas.MainMenuOnClickShadowColorInner}" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="{TemplateBinding ActualHeight}" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonText" Property="FontSize" Value="{StaticResource InertGas.LargeFontSize}" />
                            <Setter TargetName="Icon" Property="Margin" Value="{DynamicResource InertGas.SmallMarginThickness}"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="true">
                            <Setter TargetName="ShadowGrid" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ButtonText" Property="Foreground" Value="{DynamicResource InertGas.GradientMenuButtonForegroundFocusBrush}"/>
                            <Setter TargetName="ButtonText" Property="FontSize" Value="{StaticResource InertGas.MenuButtonFontSize}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource InertGas.GradientMenuButtonForegroundFocusBrush}"/>
                            <Setter TargetName="Icon" Property="Margin" Value="{DynamicResource InertGas.MediumMarginThickness}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="InertGas.ImageButton"
        TargetType="themes:ImageButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background"
        Value="{DynamicResource InertGas.ButtonBackground}"/>
        <Setter Property="BorderBrush"
        Value="{DynamicResource InertGas.ButtonBorder}"/>
        <Setter Property="BorderThickness"
        Value="1"/>
        <Setter Property="HorizontalContentAlignment"
        Value="Center"/>
        <Setter Property="VerticalContentAlignment"
        Value="Center"/>
        <Setter Property="Padding"
        Value="5,5,5,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:ImageButton">
                    <Border Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InertGas.ButtonCornerRadius}"
                    SnapsToDevicePixels="true">
                        <Grid 
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{StaticResource InertGas.SmallMarginGridLength}"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                            Name="Icon"
                            Grid.Column="0"
                            Width="{StaticResource InertGas.LargeFontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            Template="{TemplateBinding ImageSource}" />
                            <TextBlock
                            Grid.Column="2"
                            Text="{TemplateBinding Content}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="Left"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            Background="{TemplateBinding Background}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Path=TextColor, RelativeSource={RelativeSource AncestorType=themes:ImageButton}}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource InertGas.ButtonText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.Yellow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="TextColor" Value="{DynamicResource InertGas.ButtonTextDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.DarkYellow}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InertGas.ButtonBackgroundHover}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InertGas.ButtonBorderHover}"/>
                            <Setter Property="TextColor" Value="{DynamicResource InertGas.ButtonTextHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.LightYellow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InertGas.ButtonBackgroundPressed}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InertGas.ButtonBorderPressed}"/>
                            <Setter Property="TextColor" Value="{DynamicResource InertGas.ButtonTextPressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InertGas.LightYellow}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter Property="BorderBrush" Value="{DynamicResource InertGas.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type ToggleButton}"
           BasedOn="{StaticResource InertGas.BaseButtonStyle}"
           TargetType="{x:Type ToggleButton}"/>

    <Style x:Key="{x:Type RepeatButton}"
           BasedOn="{StaticResource InertGas.BaseButtonStyle}"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Stylus.IsPressAndHoldEnabled"
                Value="false"/>
    </Style>

    <Style x:Key="{x:Type Button}"
           BasedOn="{StaticResource InertGas.BaseButtonStyle}"
           TargetType="{x:Type Button}"/>
</ResourceDictionary>